# Browser/server Supabase Auth. The anon key is intentionally public; never
# place a service-role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Runtime Prisma connection: Supabase transaction pooler on port 6543.
DATABASE_URL=

# Prisma CLI migrations: Supabase direct/session connection on port 5432.
DIRECT_URL=

# Explicit browser-local reviewer mode. Keep false for shared database mode.
NEXT_PUBLIC_HALINA_DEMO_MODE=false

# Global admin allowlist and independent secondary unlock secret.
ADMIN_EMAIL=
ADMIN_PANEL_PASSWORD=

# Server-only HMAC secret for invitation/admin IP rate-limit hashes.
HALINA_RATE_LIMIT_SECRET=
